{
  "name": "ff-esports-core",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Free Fire esports tournament ecosystem with LiveTourBD aesthetics",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --prefix apps/backend-api run dev",
    "dev:web": "npm --prefix apps/web-admin run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:api": "npm --prefix apps/backend-api run build",
    "build:web": "npm --prefix apps/web-admin run build",
    "build": "node scripts/build.js",
    "start": "npm --prefix apps/web-admin run start",
    "db:generate": "npm --prefix packages/database run generate",
    "db:push": "npm --prefix packages/database run push",
    "bot:start": "cd services/bot-observer-engine && python main_observer.py"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.378.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  }
}
