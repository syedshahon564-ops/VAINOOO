# Server Configuration
PORT=4000
NODE_ENV=development

# Webhook Authentication (x-api-key header must match this value)
WEBHOOK_SECRET_KEY=super_secret_forwarder_key_change_me_in_production

# Database Connection (Default uses SQLite; change to postgresql://user:pass@host:5432/db for Postgres)
DATABASE_URL="file:./dev.db"

# Optional Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
VERIFY_RATE_LIMIT_MAX=30
