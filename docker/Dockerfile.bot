FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    android-tools-adb \
    tesseract-ocr \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY services/bot-observer-engine/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY services/bot-observer-engine/ ./

CMD ["python", "main_observer.py"]
